; @artisanpack-ui/react and @artisanpack-ui/vue both name apexcharts as an
; optional peer, and they name incompatible ranges of it — ^3.41 against
; ^5.10. Neither framework's components in this package draws a chart with it:
; the trend line is inline SVG on both sides. So the conflict is between two
; optional peers nothing here uses, and refusing to install over it would leave
; this package unable to test both halves at once.
legacy-peer-deps=true
